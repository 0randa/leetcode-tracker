# Copy to .env and fill in for a non-local (Neon) database.
# The backend reads these env vars; local defaults (docker-compose) are used if unset.

# JDBC URL. Neon example:
#   jdbc:postgresql://ep-xxx.region.aws.neon.tech/lctracker?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/lctracker
DB_USER=lctracker
DB_PASSWORD=lctracker
